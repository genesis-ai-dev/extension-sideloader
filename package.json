{
  "name": "extension-sideloader",
  "displayName": "extension-sideloader",
  "description": "Sideload extensions into VSCode",
  "author": "Andrew Hertog",
  "publisher": "andrewhertog",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewhertog/extension-sideloader"
  },
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension-sideloader.toggleForceEnable",
        "title": "Extension Sideloader: Toggle Force Enable"
      }
    ],
    "configuration": {
      "title": "Extension Sideloader",
      "properties": {
        "extensionSideloader.forceEnable": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable disabled sideloaded extensions"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.93.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.1",
    "assert": "^2.1.0",
    "sinon": "^19.0.2"
  }
}
